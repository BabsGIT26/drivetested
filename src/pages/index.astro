---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, SITE } from '../site.config';

const articles = (await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => +(b.data.updatedDate ?? b.data.pubDate) - +(a.data.updatedDate ?? a.data.pubDate));
const site = Astro.site ?? new URL(SITE.url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: site.toString(),
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: site.toString(),
    logo: new URL('/favicon.svg', site).toString(),
  },
];
---
<BaseLayout title={`${SITE.name}: ${SITE.tagline}`} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Car accessory buying guides</p>
      <h1>Tested car gear,<br />clearly explained.</h1>
      <p class="lede">Straight answers on jump starters, tire inflators, dash cams, floor mats and the rest of the gear that keeps your car ready. What the specs mean, what to skip, and which one to buy.</p>
      <div class="hero-cta">
        <a class="btn-ghost" href="/jump-starters/best-with-air-compressor/">Best jump starters with air compressors →</a>
        <a class="text-link ui" href="/how-we-test/">How we test</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section aria-labelledby="latest">
      <h2 id="latest">Latest guides</h2>
      <div class="grid">
        {articles.slice(0, 6).map((a) => (
          <ArticleCard title={a.data.title} description={a.data.description} href={`/${a.data.category}/${a.data.slug}/`} category={a.data.category} date={a.data.updatedDate ?? a.data.pubDate} />
        ))}
      </div>
    </section>

    <section aria-labelledby="browse">
      <h2 id="browse">Browse by category</h2>
      <ul class="cats">
        {CATEGORIES.map((c) => (
          <li class="card">
            <a href={`/${c.slug}/`}>{c.name}</a>
            <p>{c.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="promise card" aria-labelledby="promise">
      <h2 id="promise">Our promise</h2>
      <div class="cols">
        <div><h3>Plain English</h3><p>We explain what each spec actually means for you, so you can make the call yourself.</p></div>
        <div><h3>Honest about testing</h3><p>We say clearly what we've tested hands-on and what is based on specs and published test data.</p></div>
        <div><h3>No pay-to-play</h3><p>Brands can't buy a spot in our guides. We earn a small commission from some links. <a href="/affiliate-disclosure/">Details</a>.</p></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 2.5rem; border-bottom: 1px solid var(--line); }
  .hero h1 { font-size: clamp(2.3rem, 7vw, 4rem); letter-spacing: -0.035em; line-height: 1.04; margin: 0.5rem 0 1rem; }
  .lede { font-size: 1.25rem; max-width: 38rem; color: #2b2b2b; margin: 0 0 1.5rem; }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .text-link { font-size: 0.95rem; font-weight: 600; }
  .grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .cats { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; grid-template-columns: 1fr; }
  .cats li { padding: 1rem 1.15rem; position: relative; }
  .cats a { font-family: var(--font-head); font-weight: 700; text-decoration: none; font-size: 1.05rem; }
  .cats a::after { content: ''; position: absolute; inset: 0; }
  .cats li:hover a { text-decoration: underline; }
  .cats p { margin: 0.25rem 0 0; font-size: 0.98rem; color: var(--steel); }
  .promise { margin-top: 3rem; padding: 1.5rem; }
  .promise h2 { margin-top: 0; }
  .cols { display: grid; gap: 0.5rem 2rem; grid-template-columns: 1fr; }
  .cols h3 { margin: 0.75rem 0 0.25rem; font-size: 1.05rem; }
  .cols p { margin: 0; font-size: 1rem; }
  @media (min-width: 760px) {
    .hero { padding: 5rem 0 3.5rem; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .cats { grid-template-columns: repeat(2, 1fr); }
    .cols { grid-template-columns: repeat(3, 1fr); }
    .promise { padding: 2rem; }
  }
  @media (min-width: 1040px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .cats { grid-template-columns: repeat(4, 1fr); }
  }
</style>
