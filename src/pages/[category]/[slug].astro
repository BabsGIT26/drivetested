---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TableScroll from '../../components/mdx/TableScroll.astro';
import Illustration from '../../components/Illustration.astro';
import { ILLUSTRATION_NOUN } from '../../lib/illustrations';
import PhotoBackdrop from '../../components/PhotoBackdrop.astro';
import PhotoCredit from '../../components/PhotoCredit.astro';
import { photoForArticle } from '../../lib/photos';
import { SITE, getCategory, productAmazonUrl } from '../../site.config';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((entry) => ({
    params: { category: entry.data.category, slug: entry.data.slug },
    props: { entry, all: articles },
  }));
}

interface Props { entry: CollectionEntry<'articles'>; all: CollectionEntry<'articles'>[] }
const { entry, all } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const cat = getCategory(d.category)!;
const site = Astro.site ?? new URL(SITE.url);
const url = new URL(Astro.url.pathname, site).toString();
const updated = d.updatedDate ?? d.pubDate;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const byId = (id: string) => {
  const p = d.products.find((x) => x.id === id);
  if (!p) throw new Error(`Verdict references unknown product id "${id}" in ${entry.id}`);
  return p;
};
const picks = d.verdict?.picks.map((pk) => ({ label: pk.label, product: byId(pk.productId) })) ?? [];
const related = all
  .filter((a) => a.data.category === d.category && a.id !== entry.id)
  .sort((a, b) => +(b.data.updatedDate ?? b.data.pubDate) - +(a.data.updatedDate ?? a.data.pubDate))
  .slice(0, 3);

// "On this page" links: product picks, the article's H2s, then FAQ and sources.
const tocPicks = d.verdict && d.products.length > 1 ? d.products.map((p) => ({ id: p.id, text: p.name })) : [];
const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(d.faq.length > 0 ? [{ id: 'faq-title', text: 'FAQ' }] : []),
  ...(d.sources.length > 0 ? [{ id: 'sources-title', text: 'Sources' }] : []),
];
const showToc = toc.length >= 3;
const heroPhoto = photoForArticle(d.category, d.slug);

const publisher = {
  '@type': 'Organization',
  name: SITE.name,
  url: site.toString(),
  logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', site).toString() },
};
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    image: [new URL(SITE.ogImage, site).toString()],
    datePublished: d.pubDate.toISOString(),
    dateModified: updated.toISOString(),
    author: [{ '@type': 'Organization', name: d.author ?? SITE.author, url: new URL('/about/', site).toString() }],
    publisher,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/${cat.slug}/`, site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.products.length > 1) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: d.title,
    itemListElement: d.products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `${url}#${p.id}` })),
  });
}
// FAQPage markup mirrors the visible FAQ section exactly.
if (d.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
// Product + Review markup ONLY when the owner has actually tested and rated the product.
if (d.handsOnTested) {
  for (const p of d.products.filter((x) => typeof x.rating === 'number')) {
    jsonLd.push({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: p.name,
      brand: { '@type': 'Brand', name: p.brand },
      url: productAmazonUrl(p),
      review: {
        '@type': 'Review',
        author: { '@type': 'Organization', name: SITE.name },
        datePublished: updated.toISOString(),
        reviewRating: { '@type': 'Rating', ratingValue: p.rating, bestRating: 10, worstRating: 0 },
        positiveNotes: p.pros.length ? { '@type': 'ItemList', itemListElement: p.pros.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x })) } : undefined,
        negativeNotes: p.cons.length ? { '@type': 'ItemList', itemListElement: p.cons.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x })) } : undefined,
      },
    });
  }
}
---
<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  type="article"
  image={`/og/${d.category}/${d.slug}.png`}
  preloadPhoto={heroPhoto.name}
  publishedTime={d.pubDate}
  modifiedTime={updated}
  noindex={d.draft}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: cat.name, href: `/${cat.slug}/` }, { name: d.title, href: Astro.url.pathname }]} />
    <article class="article">
      <header class="head" style={`--cat:${cat.color}`}>
        <PhotoBackdrop photo={heroPhoto} />
        <div class="head-shade" aria-hidden="true"></div>
        <div class="head-text">
          <p class="cat-pill">{cat.name}</p>
          <h1>{d.title}</h1>
          <p class="lede">{d.description}</p>
          <p class="byline ui-small">
            By <a href="/about/">{d.author ?? SITE.author}</a> · Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time>
            · <a href="/how-we-test/">How we test and choose</a>
          </p>
        </div>
        <div class="head-art">
          <Illustration kind={cat.slug} accent={cat.color} slice label={`Illustration of ${(ILLUSTRATION_NOUN as Record<string, string>)[cat.slug] ?? 'car gear'}`} />
        </div>
        <PhotoCredit photo={heroPhoto} />
      </header>

      <AffiliateDisclosure />

      {d.verdict && <div class="measure"><VerdictBox summary={d.verdict.summary} picks={picks} /></div>}

      {d.compare && d.products.length > 1 && <ComparisonTable products={d.products} columns={d.compare} />}

      <div class:list={['article-body', { 'has-toc': showToc }]}>
        <div class="main-col">
          {showToc && (
            <details class="toc-m">
              <summary class="ui">On this page</summary>
              <nav aria-label="On this page (mobile)">
                <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
              </nav>
            </details>
          )}

          <div class="prose">
            <Content components={{ table: TableScroll }} />
          </div>

          {d.faq.length > 0 && (
            <section class="faq measure" aria-labelledby="faq-title">
              <h2 id="faq-title">Frequently asked questions</h2>
              {d.faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </section>
          )}

          {d.sources.length > 0 && (
            <section class="sources measure" aria-labelledby="sources-title">
              <h2 id="sources-title">Sources</h2>
              <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ul>
            </section>
          )}
        </div>

        {showToc && (
          <aside class="toc-d" aria-label="On this page">
            <nav aria-label="On this page">
              <p class="eyebrow">On this page</p>
              <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
              {tocPicks.length > 0 && (
                <>
                  <p class="eyebrow picks-h">Our picks</p>
                  <ol class="toc-picks">{tocPicks.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
                </>
              )}
            </nav>
          </aside>
        )}
      </div>
    </article>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">More in {cat.name}</h2>
        <div class="grid">
          {related.map((r) => (
            <ArticleCard title={r.data.title} description={r.data.description} href={`/${r.data.category}/${r.data.slug}/`} category={r.data.category} date={r.data.updatedDate ?? r.data.pubDate} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .article { padding-bottom: 1rem; }
  .head {
    position: relative; display: grid; gap: 1rem; overflow: hidden; margin-bottom: 0.5rem; isolation: isolate;
    padding: clamp(1.25rem, 4vw, 2.25rem) clamp(1rem, 3vw, 2rem) clamp(2.25rem, 4vw, 2.75rem); border-radius: 16px;
    background: var(--navy); color: #fff; border-bottom: 5px solid var(--cat);
    box-shadow: 0 18px 40px -24px rgba(11, 31, 58, .6);
  }
  .head-shade {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(28rem 16rem at 100% 0%, color-mix(in srgb, var(--cat) 35%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(11, 31, 58, .72) 0%, rgba(11, 31, 58, .86) 100%);
  }
  .head-text { position: relative; z-index: 1; min-width: 0; max-width: var(--measure); text-shadow: 0 1px 2px rgba(0, 0, 0, .3); }
  .cat-pill {
    display: inline-block; margin: 0 0 0.6rem; padding: 0.2rem 0.65rem; border-radius: 999px;
    font-family: var(--font-head); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--navy); background: #fbbf24; text-shadow: none;
  }
  .head h1 { text-wrap: balance; color: #fff; }
  .head .byline, .head .byline a { color: #cbd5e1; }
  .head .byline a:hover { color: #fbbf24; }
  .head :focus-visible { outline-color: #fbbf24; }
  .head-art { display: none; }
  @media (min-width: 800px) {
    .head { grid-template-columns: minmax(0, 1fr) clamp(13rem, 24vw, 18rem); align-items: center; gap: 2rem; }
    .head-shade {
      background:
        radial-gradient(28rem 16rem at 100% 0%, color-mix(in srgb, var(--cat) 30%, transparent), transparent 70%),
        linear-gradient(90deg, rgba(11, 31, 58, .93) 0%, rgba(11, 31, 58, .8) 50%, rgba(11, 31, 58, .35) 100%);
    }
    .head-art {
      display: block; position: relative; z-index: 1; border-radius: 12px; overflow: hidden; aspect-ratio: 16 / 10;
      border: 3px solid rgba(255, 255, 255, .9); box-shadow: 0 18px 36px -16px rgba(0, 0, 0, .65); transform: rotate(2deg);
    }
    .head-art :global(.illo), .head-art :global(svg) { width: 100%; height: 100%; }
  }
  .lede { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.25rem); color: #e2e8f0; margin: 0 0 0.75rem; }
  .byline { margin: 0; line-height: 1.6; }
  .byline a { color: var(--steel); }

  /* Mobile "On this page" */
  .toc-m { margin: 0 0 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); max-width: var(--measure); }
  .toc-m summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 1rem; font-size: 0.95rem; font-weight: 600; }
  .toc-m summary::-webkit-details-marker { display: none; }
  .toc-m summary::after { content: '+'; font-size: 1.25rem; font-weight: 500; color: var(--steel); }
  .toc-m[open] summary::after { content: '\2212'; }
  .toc-m ol { list-style: none; margin: 0; padding: 0 1rem 0.75rem; }
  .toc-m a { display: flex; align-items: center; min-height: var(--tap); font-family: var(--font-head); font-size: 0.92rem; text-decoration: none; color: var(--steel); border-top: 1px solid var(--line); }
  .toc-m a:hover { color: var(--text); }

  /* Desktop sticky table of contents */
  .toc-d { display: none; }
  @media (min-width: 72rem) {
    .article-body.has-toc { display: grid; grid-template-columns: minmax(0, var(--measure)) 15.5rem; justify-content: space-between; gap: 3rem; }
    .toc-m { display: none; }
    .toc-d { display: block; }
    .toc-d nav {
      position: sticky; top: calc(var(--header-h) + 3.75rem); max-height: calc(100vh - var(--header-h) - 5rem); overflow-y: auto;
      padding: 0.25rem 0 1rem 1.25rem; border-left: 3px solid var(--blue); margin-top: 2.5rem;
    }
    .toc-d .eyebrow { margin: 0 0 0.5rem; }
    
    .toc-d .picks-h { margin-top: 1.5rem; }
    .toc-d ol { list-style: none; margin: 0; padding: 0; }
    .toc-d li { margin: 0; }
    .toc-d a { display: block; padding: 0.35rem 0; font-family: var(--font-head); font-size: 0.85rem; line-height: 1.35; color: var(--steel); text-decoration: none; }
    .toc-d a:hover { color: var(--text); text-decoration: underline; }
  }

  /* FAQ */
  .faq details { border-bottom: 1px solid var(--line); }
  .faq details:first-of-type { border-top: 1px solid var(--line); }
  .faq summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 3.25rem; padding: 0.75rem 0; font-family: var(--font-head); font-weight: 600; font-size: 1.02rem; line-height: 1.35;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; flex: none; width: 1.75rem; height: 1.75rem; display: grid; place-items: center; border-radius: 50%; font-weight: 700; color: #fff; background: var(--blue); }
  .faq details[open] summary::after { background: var(--navy); }
  .faq details[open] summary::after { content: '\2212'; }
  .faq summary:hover { text-decoration: underline; text-underline-offset: 3px; }
  .faq details p { margin: 0 0 1rem; }

  .sources ul { font-size: 0.95rem; padding-left: 1.1rem; }
  .sources li { margin: 0.4rem 0; }
  .sources a { color: var(--steel); }
  .related { margin-top: 3rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
