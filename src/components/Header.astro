---
import { CATEGORIES, SITE } from '../site.config';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <span class="mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.2"/><path d="M7.5 12.5l3 3 6-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      Drive<span class="thin">Tested</span>
    </a>
    <details class="menu">
      <summary class="menu-btn ui">Menu</summary>
      <nav aria-label="Categories" class="menu-panel">
        <ul>
          {CATEGORIES.map((c) => (
            <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
  <nav aria-label="Categories" class="cat-nav">
    <div class="wrap">
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 3.75rem; }
  .logo { font-family: var(--font-head); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.03em; text-decoration: none; display: inline-flex; align-items: center; gap: 0.45rem; }
  .logo .thin { font-weight: 500; color: var(--steel); }
  .mark { display: inline-flex; }
  .menu { position: relative; }
  .menu-btn { list-style: none; cursor: pointer; font-size: 0.9rem; font-weight: 600; padding: 0.45rem 0.9rem; border: 1px solid var(--line-strong); border-radius: 999px; }
  .menu-btn::-webkit-details-marker { display: none; }
  .menu-panel { position: absolute; right: 0; top: calc(100% + 0.5rem); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.5rem; min-width: 14rem; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
  .menu-panel ul { list-style: none; margin: 0; padding: 0; }
  .menu-panel a { display: block; padding: 0.55rem 0.75rem; font-family: var(--font-head); font-size: 0.95rem; text-decoration: none; border-radius: 6px; }
  .menu-panel a:hover, .menu-panel a[aria-current] { background: var(--bg); }
  .cat-nav { display: none; border-top: 1px solid var(--line); }
  .cat-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; overflow-x: auto; }
  .cat-nav a { display: block; padding: 0.7rem 0; font-family: var(--font-head); font-size: 0.875rem; font-weight: 500; color: var(--steel); text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent; }
  .cat-nav a:hover { color: var(--text); }
  .cat-nav a[aria-current] { color: var(--text); border-bottom-color: var(--text); }
  @media (min-width: 900px) {
    .menu { display: none; }
    .cat-nav { display: block; }
  }
</style>
