---
import { CATEGORIES, SITE } from '../site.config';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <span class="mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.2"/><path d="M7.5 12.5l3 3 6-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      Drive<span class="thin">Tested</span>
    </a>
    <a class="htw ui" href="/how-we-test/">How we test</a>
    <details class="menu">
      <summary class="menu-btn ui">
        <svg class="i-open" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <svg class="i-close" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span>Menu</span>
      </summary>
      <nav aria-label="Main menu" class="menu-panel">
        <p class="eyebrow">Categories</p>
        <ul>
          {CATEGORIES.map((c) => (
            <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
          ))}
        </ul>
        <ul class="secondary">
          <li><a href="/how-we-test/" aria-current={path.startsWith('/how-we-test/') ? 'page' : undefined}>How we test</a></li>
          <li><a href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>About</a></li>
        </ul>
      </nav>
    </details>
  </div>
  <nav aria-label="Categories" class="cat-nav">
    <div class="wrap">
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header { background: var(--navy); color: #fff; position: sticky; top: 0; z-index: 30; box-shadow: 0 1px 0 rgba(255,255,255,.06), 0 6px 20px -10px rgba(0,0,0,.5); }
  .site-header::after { content: ''; position: absolute; left: 0; right: 0; bottom: -3px; height: 3px; background: linear-gradient(90deg, var(--blue) 0%, var(--blue) 60%, var(--amber) 60%, var(--amber) 64%, transparent 64%, transparent 68%, var(--amber) 68%, var(--amber) 72%, transparent 72%); opacity: .95; }
  .bar { display: flex; align-items: center; gap: 1rem; height: var(--header-h); }
  .logo { color: #fff; font-family: var(--font-head); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.03em; text-decoration: none; display: inline-flex; align-items: center; gap: 0.45rem; min-height: var(--tap); margin-right: auto; }
  .logo .thin { font-weight: 500; color: #93c5fd; }
  .logo:hover { color: #fff; }
  .mark { display: inline-flex; color: var(--amber); }
  .htw { display: none; font-size: 0.9rem; font-weight: 600; text-decoration: none; color: #cbd5e1; padding: 0.6rem 0; }
  .htw:hover { color: #fff; }

  /* Mobile menu: native <details>, no JavaScript */
  .menu { position: static; }
  .menu-btn {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.9rem; font-weight: 600; min-height: var(--tap); padding: 0 1rem;
    border: 1px solid rgba(255,255,255,.28); border-radius: 999px; background: rgba(255,255,255,.08); color: #fff; user-select: none;
  }
  .menu-btn::-webkit-details-marker { display: none; }
  .menu-btn::marker { content: ''; }
  .menu-btn:hover { border-color: #fff; }
  .i-close { display: none; }
  .menu[open] .i-open { display: none; }
  .menu[open] .i-close { display: inline; }
  .menu-panel {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--surface); color: var(--text); border-bottom: 3px solid var(--blue);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.08);
    padding: 0.75rem var(--gutter) 1.25rem; max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
  }
  .menu-panel .eyebrow { margin: 0.25rem 0 0.25rem; }
  .menu-panel ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; }
  .menu-panel a {
    display: flex; align-items: center; min-height: 48px; padding: 0 0.25rem;
    font-family: var(--font-head); font-size: 1.05rem; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line);
  }
  .menu-panel a:hover, .menu-panel a[aria-current] { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  .menu-panel .secondary { margin-top: 0.75rem; }
  .menu-panel .secondary a { font-size: 0.95rem; color: var(--steel); font-weight: 500; border-bottom: 0; min-height: var(--tap); }
  @media (min-width: 520px) {
    .menu-panel ul:not(.secondary) { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; }
  }

  /* Desktop category bar */
  .cat-nav { display: none; background: var(--navy-2); }
  .cat-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.75rem; overflow-x: auto; scrollbar-width: none; }
  .cat-nav ul::-webkit-scrollbar { display: none; }
  .cat-nav a { display: flex; align-items: center; min-height: 2.75rem; font-family: var(--font-head); font-size: 0.875rem; font-weight: 500; color: #cbd5e1; text-decoration: none; white-space: nowrap; border-bottom: 3px solid transparent; }
  .cat-nav a:hover { color: #fff; }
  .cat-nav a[aria-current] { color: #fff; border-bottom-color: var(--amber); font-weight: 600; }
  .site-header :focus-visible { outline-color: #fbbf24; }
  .menu-panel :focus-visible { outline-color: var(--blue); }
  @media (min-width: 900px) {
    .menu { display: none; }
    .htw { display: inline-flex; }
    .cat-nav { display: block; }
  }
</style>
