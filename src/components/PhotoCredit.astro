---
import type { StockPhoto } from '../lib/photos';
interface Props { photo: StockPhoto }
const { photo } = Astro.props;
---
<p class="photo-credit">Photo: <a href={photo.source} rel="noopener" target="_blank">{photo.photographer}</a> / {photo.platform}</p>
<style>
  .photo-credit {
    position: absolute; right: 0.6rem; bottom: 0.45rem; z-index: 2; margin: 0;
    font-family: var(--font-head); font-size: 0.68rem; line-height: 1.3; color: #e2e8f0;
    background: rgba(11, 31, 58, .72); padding: 0.15rem 0.5rem; border-radius: 4px;
  }
  .photo-credit a { color: #fff; text-decoration: underline; text-decoration-color: rgba(255,255,255,.5); }
  .photo-credit a:hover { color: #fbbf24; }
</style>
