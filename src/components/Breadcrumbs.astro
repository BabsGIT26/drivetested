---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="crumbs ui-small">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { margin: 1.5rem 0 1rem; }
  ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  li:not(:last-child)::after { content: '/'; margin-left: 0.35rem; color: var(--line-strong); }
  a { color: var(--steel); text-decoration: none; }
  a:hover { color: var(--text); text-decoration: underline; }
  span { color: var(--text); }
</style>
