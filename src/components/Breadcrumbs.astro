---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="crumbs ui-small">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { margin: 1rem 0 0.75rem; }
  ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; column-gap: 0.35rem; }
  li { min-width: 0; }
  li:not(:last-child)::after { content: '/'; margin-left: 0.35rem; color: var(--steel); opacity: 0.6; }
  a { display: inline-block; padding: 0.55rem 0; color: var(--steel); text-decoration: none; }
  a:hover { color: var(--text); text-decoration: underline; }
  span { color: var(--text); }
  /* Long titles: keep the trail on one line on phones */
  @media (max-width: 40rem) {
    ol { flex-wrap: nowrap; }
    li:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1 1 auto; }
    li:not(:last-child) { flex: none; }
  }
</style>
