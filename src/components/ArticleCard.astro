---
import { getCategory } from '../site.config';
interface Props { title: string; description: string; href: string; category: string; date: Date }
const { title, description, href, category, date } = Astro.props;
const cat = getCategory(category);
---
<article class="a-card card">
  <p class="eyebrow">{cat?.name}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="desc">{description}</p>
  <p class="ui-small">Updated <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></p>
</article>
<style>
  .a-card { padding: 1.25rem; position: relative; display: flex; flex-direction: column; }
  h3 { margin: 0.35rem 0 0.5rem; font-size: 1.15rem; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .a-card:hover h3 a { text-decoration: underline; }
  .desc { font-size: 1rem; margin: 0 0 0.75rem; color: #2b2b2b; flex: 1; }
  .ui-small { margin: 0; }
</style>
