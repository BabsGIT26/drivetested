---
import AmazonButton from './AmazonButton.astro';

interface Pick { label: string; product: { id: string; name: string; asin?: string; amazonSearch?: string; score?: number } }
interface Props { summary: string; picks: Pick[] }
const { summary, picks } = Astro.props;
---
<section class="verdict card" aria-labelledby="verdict-title">
  <p class="eyebrow">The short answer</p>
  <h2 id="verdict-title">Our verdict</h2>
  <p class="summary">{summary}</p>
  {picks.length > 0 && (
    <ol class="picks">
      {picks.map((p) => (
        <li>
          <div class="pick-text">
            <span class="label">{p.label}</span>
            <a class="name" href={`#${p.product.id}`}>{p.product.name}{typeof p.product.score === 'number' && <span class="sc"> · {p.product.score.toFixed(1)}/10</span>}</a>
          </div>
          <AmazonButton asin={p.product.asin} search={p.product.amazonSearch} size="sm" productName={p.product.name} />
        </li>
      ))}
    </ol>
  )}
</section>
<style>
  .verdict { padding: 1.25rem; margin: 1.5rem 0 2rem; }
  .verdict h2 { margin: 0.15rem 0 0.5rem; font-size: 1.35rem; }
  .summary { margin: 0 0 1rem; }
  .picks { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .picks li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
  .picks li:last-child { border-bottom: 0; padding-bottom: 0; }
  .pick-text { display: flex; flex-direction: column; min-width: 0; }
  .label { font-family: var(--font-head); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--steel); font-weight: 600; }
  .name { font-family: var(--font-head); font-weight: 650; font-size: 1rem; text-decoration: none; }
  .name:hover { text-decoration: underline; }
  .sc { color: var(--steel); font-weight: 600; }
  @media (min-width: 640px) { .verdict { padding: 1.75rem; } }
</style>
