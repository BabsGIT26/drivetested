---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site.config';

interface Props { title: string; description: string; heading?: string; lede?: string; noindex?: boolean }
const { title, description, heading = title, lede, noindex } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const home = new URL('/', Astro.site ?? SITE.url).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: home },
      { '@type': 'ListItem', position: 2, name: heading, item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: heading, href: Astro.url.pathname }]} />
    <article class="prose page">
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </article>
  </div>
</BaseLayout>
<style>
  .page { padding-bottom: 1rem; }
  .lede { font-size: 1.3rem; color: #2b2b2b; }
</style>
